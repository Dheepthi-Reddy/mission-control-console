# Copy to .env (git-ignored) and fill in. Never commit a real key.

# Your Anthropic API key. Without it the app runs in demo mode (canned replies, $0).
ANTHROPIC_API_KEY=

# Optional: Claude model for every step (default claude-opus-5-5).
# MISSION_CONTROL_MODEL=claude-opus-5-5

# Optional: force "demo" even when a key is set, or "anthropic".
# MISSION_CONTROL_LLM=

# Optional: where reports are stored (default data/mission_control.db).
# MISSION_CONTROL_DB=data/mission_control.db
